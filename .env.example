# Copy to .env.local and fill in what you use. Everything is optional;
# without these the app runs fully offline on one phone.

# AI recipe ideas, receipt scanning, site search: URL of the FridgeChef AI server (see server/).
EXPO_PUBLIC_AI_URL=http://192.168.1.10:8787
# Optional shared secret; must match APP_TOKEN on the server.
EXPO_PUBLIC_AI_TOKEN=

# Shared household (Supabase → Project Settings → API). The anon/publishable key is
# meant to ship in apps; never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
